# Copy to .env.local and fill in. Never commit a file with real values (.gitignore already excludes .env*).

# Base URL of the Vouch API, no trailing slash. Read at build time (NEXT_PUBLIC_ values are inlined).
# Leave unset to use the in-browser mock API with demo data (the default for local dev, CI and previews).
# Examples: http://localhost:5080  or  /api (if the app proxies the API on its own origin)
NEXT_PUBLIC_API_BASE_URL=
